;; Dependencies come from deps.edn (:cljs alias) — do not duplicate them here.
;; :cljs-test (paths-only, no :main-opts) puts test/ on the classpath so the
;; :test-node build can run the .cljc engine tests on ClojureScript too.
{:deps      {:aliases [:cljs :cljs-test]}
 :nrepl     {:port 7002}

 ;; Static files are served from :root; anything not found on disk (i.e. /api/*)
 ;; is proxied to the Clojure server. The WebSocket dials :3000 directly via the
 ;; closure-define below, so we don't depend on WS proxying behaviour.
 :dev-http  {8080 {:root      "resources/public"
                   :proxy-url "http://localhost:3000"}}

 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/js"
   :asset-path "/js"
   ;; Two modules, because livekit-client is about half the compiled application
   ;; and this game is played on phones. Requiring it directly roughly doubled the
   ;; bundle — paid on first paint, before anyone has decided whether they want
   ;; voice at all. `:audio` is fetched by `shadow.lazy` the first time somebody
   ;; taps to join.
   ;;
   ;; The split is only as good as the require graph: if any namespace that loads
   ;; on first paint requires werwolf.audio-impl directly, its code moves back
   ;; into :main and the only symptom is a bundle quietly twice the size. The
   ;; module sizes printed by `bb build:cljs` are the check — see werwolf.audio.
   :modules    {:main  {:init-fn werwolf.core/init}
                :audio {:entries    [werwolf.audio-impl]
                        :depends-on #{:main}}}

   ;; REQUIRED for the split above to work at runtime, not merely to build.
   ;;
   ;; Without it `shadow.lazy/load` throws "shadow.loader API was called before
   ;; shadow.loader.init!" the moment somebody taps to join, and voice never
   ;; loads — in development or in production. The build succeeds, both modules
   ;; are emitted, and /js/audio.js is served correctly; nothing about the
   ;; artifacts hints that the loader was never initialised.
   ;;
   ;; Found by test/browser/voice.spec.js, which is the only thing in the project
   ;; that has ever executed the loading path. Verifying that the chunk was SERVED
   ;; is not the same as verifying it can be FETCHED.
   :module-loader true

   ;; re-frame-10x is deliberately NOT preloaded. Its panel is an overlay on
   ;; the page itself, and on a phone — which is how this game is actually
   ;; played — it covers the board rather than sitting beside it. To bring it
   ;; back for a debugging session, restore the preload and the trace define:
   ;;
   ;;   :preloads [day8.re-frame-10x.preload]
   ;;   re-frame.trace/trace-enabled? true
   ;;
   ;; The dependency stays in deps.edn so that is a two-line change, not a
   ;; dependency hunt.
   ;; No :ws-url define. It was pinned to ws://localhost:3000 here, which works
   ;; on the machine running the server and nowhere else — on a phone the client
   ;; dialled the phone. werwolf.config derives the endpoint from the page's own
   ;; origin instead, and hops :8080 to :3000 for the dev-http case.
   :dev        {:devtools {:after-load werwolf.core/reload!}}

   :release    {:compiler-options {:optimizations :advanced
                                   :infer-externs :auto}}}

  ;; Runs the .cljc engine tests on ClojureScript, so cross-platform claims
  ;; (notably werwolf.engine.rng producing identical numbers) are enforced.
  :test-node
  {:target    :node-test
   :output-to "target/node-tests.js"
   :ns-regexp "-test$"}}}

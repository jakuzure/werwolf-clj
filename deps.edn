{:paths ["src/clj" "src/cljc" "resources"]

 :deps
 {org.clojure/clojure                 {:mvn/version "1.12.6"}

  ;; --- shared engine (cljc) ---
  metosin/malli                       {:mvn/version "0.20.3"}
  tongue/tongue                       {:mvn/version "0.4.4"}

  ;; --- server ---
  http-kit/http-kit                   {:mvn/version "2.8.1"}
  ;; 1.15.3 matches what reitit-ring wants; brings ring.websocket + protocols.
  ring/ring-core                      {:mvn/version "1.15.6"}
  metosin/reitit-ring                 {:mvn/version "0.11.0"}
  integrant/integrant                 {:mvn/version "1.0.1"}
  aero/aero                           {:mvn/version "1.1.6"}
  com.cognitect/transit-clj           {:mvn/version "1.1.363"}
  buddy/buddy-sign                    {:mvn/version "3.6.1-359"}

  ;; --- persistence ---
  com.github.seancorfield/next.jdbc   {:mvn/version "1.4.72"}
  org.xerial/sqlite-jdbc              {:mvn/version "3.53.4.0"}

  ;; --- metrics (werwolf.metrics) ---
  io.prometheus/prometheus-metrics-core                  {:mvn/version "1.10.0"}
  io.prometheus/prometheus-metrics-exporter-httpserver   {:mvn/version "1.10.0"}
  io.prometheus/prometheus-metrics-instrumentation-jvm   {:mvn/version "1.10.0"}

  ;; --- logging ---
  org.clojure/tools.logging           {:mvn/version "1.3.1"}
  org.slf4j/slf4j-api                 {:mvn/version "2.0.20"}
  ch.qos.logback/logback-classic      {:mvn/version "1.6.5"}}

 :aliases
 {;; REPL-driven dev: (require 'dev) (dev/go)
  :dev
  {:extra-paths ["dev" "test"]
   :extra-deps  {integrant/repl              {:mvn/version "0.5.1"}
                 org.clojure/tools.namespace {:mvn/version "1.5.1"}
                 djblue/portal               {:mvn/version "0.68.1"}
                 org.clojure/test.check      {:mvn/version "1.1.3"}
                 nrepl/nrepl                 {:mvn/version "1.8.0"}
                 cider/cider-nrepl           {:mvn/version "0.63.1"}}
   :main-opts   ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"
                 "--interactive"]}

  ;; ClojureScript build (frontend deps live here, not in :deps)
  :cljs
  {:extra-paths ["src/cljs"]
   :extra-deps  {thheller/shadow-cljs      {:mvn/version "3.5.7"}
                 re-frame/re-frame         {:mvn/version "1.4.7"}
                 ;; re-frame 1.4.7 does NOT depend on reagent transitively — declare it.
                 ;; Deliberately reagent 1.x / React 18: reagent 2 + React 19 has known
                 ;; re-frame friction and we want the well-trodden path.
                 reagent/reagent           {:mvn/version "2.0.1"}
                 metosin/reitit-frontend   {:mvn/version "0.11.0"}
                 com.cognitect/transit-cljs {:mvn/version "0.8.280"}
                 ;; re-frame-10x: inspect app-db / event history in the browser.
                 ;; Kept on the dev classpath but NOT preloaded — its panel is an
                 ;; overlay, and this game is played on phones, where it covers the
                 ;; board. See shadow-cljs.edn for the two lines that switch it on.
                 day8.re-frame/re-frame-10x {:mvn/version "1.12.3"}
                 binaryage/devtools         {:mvn/version "1.0.7"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps  {lambdaisland/kaocha     {:mvn/version "1.91.1392"}
                 org.clojure/test.check  {:mvn/version "1.1.3"}}
   :main-opts   ["-m" "kaocha.runner"]}

  ;; Paths-only test alias. shadow-cljs launches `clojure` with its :aliases,
  ;; so any alias it uses must NOT carry :main-opts — kaocha's would hijack the
  ;; process. Used by the :test-node build.
  :cljs-test
  {:extra-paths ["test"]
   :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}}}

  :build
  {:extra-paths ["build"]
   ;; Clojure pinned here too. `-T` REPLACES :deps, so without this the build
   ;; runs on whatever Clojure the installed CLI defaults to — different on
   ;; every machine, and absent from deps-lock.json, which is what made the
   ;; offline nix build fail.
   :deps        {io.github.clojure/tools.build {:mvn/version "0.10.7"}
                 org.clojure/clojure           {:mvn/version "1.12.0"}}
   :ns-default  build}}}

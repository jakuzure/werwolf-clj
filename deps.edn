{:paths ["src/clj" "src/cljc" "resources"]

 :deps
 {org.clojure/clojure                 {:mvn/version "1.12.0"}

  ;; --- shared engine (cljc) ---
  metosin/malli                       {:mvn/version "0.20.1"}
  tongue/tongue                       {:mvn/version "0.4.4"}

  ;; --- server ---
  http-kit/http-kit                   {:mvn/version "2.8.1"}
  ;; 1.15.3 matches what reitit-ring wants; brings ring.websocket + protocols.
  ring/ring-core                      {:mvn/version "1.15.3"}
  metosin/reitit-ring                 {:mvn/version "0.10.1"}
  integrant/integrant                 {:mvn/version "1.0.1"}
  aero/aero                           {:mvn/version "1.1.6"}
  com.cognitect/transit-clj           {:mvn/version "1.0.333"}
  buddy/buddy-sign                    {:mvn/version "3.6.1-359"}

  ;; --- persistence ---
  com.github.seancorfield/next.jdbc   {:mvn/version "1.3.1118"}
  org.xerial/sqlite-jdbc              {:mvn/version "3.49.1.0"}

  ;; --- logging ---
  org.clojure/tools.logging           {:mvn/version "1.3.0"}
  org.slf4j/slf4j-api                 {:mvn/version "2.0.16"}
  ch.qos.logback/logback-classic      {:mvn/version "1.5.16"}}

 :aliases
 {;; REPL-driven dev: (require 'dev) (dev/go)
  :dev
  {:extra-paths ["dev" "test"]
   :extra-deps  {integrant/repl              {:mvn/version "0.4.0"}
                 org.clojure/tools.namespace {:mvn/version "1.5.0"}
                 djblue/portal               {:mvn/version "0.67.1"}
                 org.clojure/test.check      {:mvn/version "1.1.1"}
                 nrepl/nrepl                 {:mvn/version "1.3.1"}
                 cider/cider-nrepl           {:mvn/version "0.50.2"}}
   :main-opts   ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"
                 "--interactive"]}

  ;; ClojureScript build (frontend deps live here, not in :deps)
  :cljs
  {:extra-paths ["src/cljs"]
   :extra-deps  {thheller/shadow-cljs      {:mvn/version "3.4.12"}
                 re-frame/re-frame         {:mvn/version "1.4.7"}
                 ;; re-frame 1.4.7 does NOT depend on reagent transitively — declare it.
                 ;; Deliberately reagent 1.x / React 18: reagent 2 + React 19 has known
                 ;; re-frame friction and we want the well-trodden path.
                 reagent/reagent           {:mvn/version "1.2.0"}
                 metosin/reitit-frontend   {:mvn/version "0.10.1"}
                 com.cognitect/transit-cljs {:mvn/version "0.8.280"}
                 ;; re-frame-10x: inspect app-db / event history in the browser.
                 ;; Genuinely the fastest way to learn re-frame's data flow.
                 day8.re-frame/re-frame-10x {:mvn/version "1.12.3"}
                 binaryage/devtools         {:mvn/version "1.0.7"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps  {lambdaisland/kaocha     {:mvn/version "1.91.1392"}
                 org.clojure/test.check  {:mvn/version "1.1.1"}}
   :main-opts   ["-m" "kaocha.runner"]}

  ;; Paths-only test alias. shadow-cljs launches `clojure` with its :aliases,
  ;; so any alias it uses must NOT carry :main-opts — kaocha's would hijack the
  ;; process. Used by the :test-node build.
  :cljs-test
  {:extra-paths ["test"]
   :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}}}

  :build
  {:extra-paths ["build"]
   :deps        {io.github.clojure/tools.build {:mvn/version "0.10.7"}}
   :ns-default  build}}}

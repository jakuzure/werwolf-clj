{:min-bb-version "1.3.0"

 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :as p]
             [clojure.string :as str])

  ;; ---------- setup ----------
  npm-install
  {:doc "Install JS deps (React, Tailwind, shadow-cljs runtime)"
   :task (when (seq (fs/modified-since "node_modules" "package.json"))
           (shell "npm install"))}

  ;; ---------- dev ----------
  dev:cljs
  {:doc     "Watch + hot-reload the frontend on :8080 (shadow-cljs dev server)"
   :depends [npm-install]
   :task    (shell "npx shadow-cljs watch app")}

  dev:css
  {:doc     "Watch Tailwind"
   :depends [npm-install]
   :task    (shell "npx @tailwindcss/cli -i ./src/css/main.css -o ./resources/public/css/main.css --watch")}

  dev:repl
  {:doc  "Start an nREPL with the dev alias. The system is NOT running until you
          evaluate (require 'dev) (dev/go) — use this when you want the REPL
          workflow, `bb serve` when you just want the game up."
   :task (clojure "-M:dev:cljs:test")}

  serve
  {:doc  "Run the server directly on :3000, no REPL. Serves resources/public,
          so whatever shadow-cljs last built is what you get."
   :task (clojure "-M -m werwolf.main")}

  dev
  {:doc     "The whole dev stack in one terminal: server, shadow-cljs watch and
             tailwind watch. Ctrl-C stops all three.

             Open http://localhost:3000 — the app is served by the Clojure
             server itself. (http://localhost:8080 also works and adds
             shadow's live CSS/HTML reload, but it proxies to :3000, so it only
             works while the server is up.)"
   :depends [npm-install]
   :task
   ;; NOTE: bb.edn is read as plain EDN, so reader macros are unavailable in
   ;; here — no #() and no @deref. Both fail at load time, not at run time.
   (let [procs (mapv (fn [cmd] (p/process cmd {:inherit true
                                               :shutdown p/destroy-tree}))
                     [["clojure" "-M" "-m" "werwolf.main"]
                      ["npx" "shadow-cljs" "watch" "app"]
                      ["npx" "@tailwindcss/cli"
                       "-i" "./src/css/main.css"
                       "-o" "./resources/public/css/main.css" "--watch"]])]
     (println "\n  → http://localhost:3000   (or :8080 for live CSS reload)\n")
     ;; Wait on all three. If any exits, its status surfaces; the others are
     ;; torn down by the :shutdown hook rather than left orphaned holding :3000.
     (doseq [proc procs] (deref proc)))}

  dev:livekit
  {:doc "Start the local LiveKit for voice, advertising this machine's LAN IP.

         The IP matters: LiveKit puts it in its ICE candidates, and a browser
         that cannot reach it connects the signalling and then sits there until
         it gives up. 127.0.0.1 works for Chrome on this machine and for nothing
         else — Firefox filters loopback candidates, and on a phone it IS the
         phone. The LAN address satisfies all three, so it is computed here
         rather than left as a thing to remember.

         Stop it with:
           docker compose -f deploy/livekit.dev.yml down"
   :task
   ;; NOTE: no #() here — bb.edn is plain EDN, as the `dev` task's comment says.
   (let [probe (fn [iface]
                 (str/trim (str (:out (p/shell {:out :string :continue true}
                                               "ipconfig" "getifaddr" iface)))))
         ip    (or (first (remove str/blank? (map probe ["en0" "en1"])))
                   "127.0.0.1")]
     (println (str "  LiveKit will advertise " ip
                   (when (= ip "127.0.0.1")
                     "  (no LAN address found — Firefox and phones will not connect)")))
     (shell {:extra-env {"LIVEKIT_DEV_NODE_IP" ip}}
            "docker compose -f deploy/livekit.dev.yml up -d --force-recreate"))}

  ;; ---------- quality ----------
  test
  {:doc  "Run the Clojure test suite (engine + sim harness)"
   :task (clojure "-M:test")}

  test:cljs
  {:doc     "Run the .cljc engine tests on ClojureScript/Node.
             Guards cross-platform claims (e.g. rng producing identical numbers)."
   :depends [npm-install]
   :task    (do (shell "npx shadow-cljs compile test-node")
                (shell "node target/node-tests.js"))}

  check:app
  {:doc     "Compile the BROWSER build, purely to prove it compiles.

             werwolf.audio reaches livekit-client through shadow.lazy, which
             resolves against the :app build's module split — so the :test-node
             target, which has no modules, cannot compile it at all. Without this
             task a syntax error in werwolf.audio or werwolf.audio-impl would sail
             through `bb test:all`.

             Exactly the trap client_test already guards for werwolf.views, where
             a local binding named `set!` passed the whole suite green."
   :depends [npm-install]
   :task    (shell "npx shadow-cljs compile app")}

  test:browser
  {:doc     "Drive the app in a real browser (Playwright).

             Covers the only layer the other suites cannot reach: the DOM,
             reagent's reconciliation, and a real WebSocket. Runs against the
             RELEASE build, deliberately — two of the bugs this suite exists to
             catch only exist under :advanced optimisation, so testing the dev
             build would test the artifact nobody ships.

             Playwright starts and stops the server itself, on :3999 with a fresh
             temp database. Voice tests skip unless a LiveKit is reachable:
             `docker compose -f deploy/livekit.dev.yml up -d`."
   :depends [build:cljs build:css]
   :task    (shell "npx playwright test --config test/browser/playwright.config.js")}

  test:all
  {:doc     "Run the suite on both platforms, and compile the browser build.
             Does NOT include test:browser — it needs a browser download and is
             an order of magnitude slower; run it explicitly."
   :depends [test test:cljs check:app]}

  test:watch
  {:doc  "Re-run tests on change"
   :task (clojure "-M:test --watch --fail-fast")}

  ;; ---------- build ----------
  clean
  {:doc  "Remove build artifacts"
   :task (doseq [d ["target" "resources/public/js" ".shadow-cljs" ".cpcache"]]
           (fs/delete-tree d))}

  build:cljs
  {:doc     "Compile optimized frontend into a CLEAN output directory"
   :depends [npm-install]
   :task
   ;; The delete is load-bearing. A release build writes main.js and leaves
   ;; whatever the last DEV build put there — cljs-runtime/, 986 files and 30 MB
   ;; of per-namespace output plus the .cljs/.cljc sources its source maps point
   ;; at. shadow-cljs does not clean between targets, `resources` is on the
   ;; classpath, so the uberjar packed all of it: a 45 MB jar to ship a 676 KB
   ;; main.js, with the entire client and engine source inside it.
   ;;
   ;; Harmless at runtime — a release main.js is self-contained and never asks
   ;; for cljs-runtime — which is exactly why it went unnoticed. Cleaning here
   ;; rather than in `uberjar` means the invariant is "the release output dir
   ;; contains only what the release build emitted", which is checkable by
   ;; looking at it.
   (do (fs/delete-tree "resources/public/js")
       (shell "npx shadow-cljs release app"))}

  build:css
  {:doc     "Compile minified CSS"
   :depends [npm-install]
   :task    (shell "npx @tailwindcss/cli -i ./src/css/main.css -o ./resources/public/css/main.css --minify")}

  uberjar
  {:doc              "Build the deployable uberjar"
   :override-builtin true
   :depends          [build:cljs build:css]
   :task             (clojure "-T:build uber")}

  docker
  {:doc     "Build the container image"
   :depends [uberjar]
   :task    (shell "docker build -t werwolf-clj:latest -f deploy/Dockerfile .")}}}

{:server  {:port     #long #or [#env PORT 3000]
           :host     #or [#env HOST "0.0.0.0"]}

 :db      {:dbtype   "sqlite"
           :dbname   #or [#env DB_PATH "data/werwolf.db"]}

 ;; HS256 secret for reconnect tokens. MUST be overridden in production.
 :tokens  {:secret   #or [#env TOKEN_SECRET "dev-only-insecure-secret-change-me"]
           :ttl-mins #long #or [#env TOKEN_TTL_MINS 720]}

 ;; Media provider: :noop for v1 (text chat only), :livekit at M7.
 :media   {:provider   #keyword #or [#env MEDIA_PROVIDER "noop"]
           :url        #or [#env LIVEKIT_URL ""]
           :api-key    #or [#env LIVEKIT_API_KEY ""]
           :api-secret #or [#env LIVEKIT_API_SECRET ""]
           ;; Rooms are named <prefix><room code>. Only a PR preview changes it,
           ;; so its rooms stay apart from production's on the shared LiveKit.
           :room-prefix #or [#env LIVEKIT_ROOM_PREFIX "werwolf-"]}

 :game    {;; Server-authoritative phase durations, seconds. Which phases are
           ;; timed at all is a rule and lives in werwolf.engine.phases;
           ;; only their length is deployment policy.
           :discussion-secs #long #or [#env DISCUSSION_SECS 300]
           :night-secs      #long #or [#env NIGHT_SECS 45]
           ;; The Bürgermeister election, day one only. Short: it is half a
           ;; formality and half the first read on the room, and a long clock
           ;; here just delays the game everybody came for.
           :election-secs   #long #or [#env ELECTION_SECS 60]
           ;; Generous: the Jäger has just been told he is dead and the whole
           ;; table is waiting on him.
           :reaction-secs   #long #or [#env REACTION_SECS 30]
           ;; Rule variant. false (default): the werewolves have no turn on the
           ;; first night, so nobody is eliminated before they have said a word.
           ;; true restores the classic Düsterwald rule.
           :first-night-kill? #boolean #or [#env FIRST_NIGHT_KILL "false"]
           ;; Rule variant. false (default): nobody is accused on the first
           ;; day — nobody knows anything yet, so it is talk and the election,
           ;; and then the night. true restores the classic Düsterwald rule.
           :first-day-trial? #boolean #or [#env FIRST_DAY_TRIAL "false"]
           ;; Whether a new room's creator narrates rather than plays. true
           ;; (default): the creator is the Spielleiter — dealt no card, sees
           ;; every card, and the room starts without a clock. The host can
           ;; switch either in the lobby. false restores the creator as an
           ;; ordinary player with GM powers on the side.
           :narrated?       #boolean #or [#env NARRATED "true"]
           ;; A room nobody is connected to is dropped after this long. Aimed at
           ;; lobbies somebody opened and closed the tab on: they would otherwise
           ;; be listed to every newcomer forever.
           :room-idle-ms    #long #or [#env ROOM_IDLE_MS 300000]
           ;; The same for a game already under way, and deliberately far longer:
           ;; a locked phone drops its socket, so a table that put their phones
           ;; down looks identical to an abandoned game.
           :game-idle-ms    #long #or [#env GAME_IDLE_MS 1800000]
           ;; Dropping an idle game from memory is not the end of it: the log
           ;; brings it back on every boot. An unfinished game no player has
           ;; touched for this many hours is closed for good instead — ended in
           ;; the log, kept for a recap, never loaded again. (An idle lobby goes
           ;; at :room-idle-ms; nothing has been dealt there to lose.)
           :abandon-after-hours #long #or [#env ABANDON_AFTER_HOURS 24]
           ;; How long the host's seat may stand empty before the room stops
           ;; waiting for him: the Chronik says he is gone, his seat is offered
           ;; where that is safe, and a narrated game hands its pace to the
           ;; clock. Long enough for a phone to find its signal again.
           :host-grace-secs #long #or [#env HOST_GRACE_SECS 45]
           :min-players     #long #or [#env MIN_PLAYERS 5]
           :max-players     #long #or [#env MAX_PLAYERS 18]}}
